rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App settings (Wave payment info, form config, CMS text)
    match /app_settings/{docId} {
      allow read, write: if true;
    }

    // Registrations
    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // Tombstones of deleted registrations
    match /deleted_registrations/{id} {
      allow read, write: if true;
    }

    // Admin accounts
    match /admin_accounts/{adminId} {
      allow read, write: if true;
    }

    // Registration drafts (Autosave)
    match /registration_drafts/{sessionId} {
      allow read, write: if true;
    }

    // Deny all other collection access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
